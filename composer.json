{
    "name": "plusehours/plusehours",
    "description": "PluseHours Time Tracking Application",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "twig/twig": "^3.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "classmap": [
            "src/Repository",
            "src/Service",
            "includes",
            "config"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find apps src includes config auth sso database -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "optimize-autoloader": true
    }
}
